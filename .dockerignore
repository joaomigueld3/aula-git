# Elas devem ser instaladas DENTRO do container via 'npm install'
# para garantir compatibilidade com o S.O. do container (Linux).
node_modules

# Arquivos de log gerados durante o desenvolvimento.
# Eles não devem fazer parte da imagem final.
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos de ambiente local. Contêm segredos e configurações
# que não devem ser incluídos na imagem. Use variáveis de ambiente
# no docker-compose.yml ou em produção.
.env
.env.local
.env.*.local

# Pastas de configuração de IDEs e editores de código.
.idea/
.vscode/
*.swp

# Arquivos específicos do sistema operacional.
.DS_Store
Thumbs.db

# Pastas de output de builds, testes ou bundles.
# Se precisar de um build, o ideal é fazê-lo dentro de um Dockerfile multi-stage.
dist/
build/
coverage/

# Pasta do Git. É grande e completamente desnecessária na imagem.
.git

# O próprio Dockerfile e arquivos relacionados ao Docker não precisam
# ser copiados para dentro da imagem.
Dockerfile
docker-compose.yml
.dockerignore

# Arquivos de documentação que não são necessários para a aplicação rodar.
README.md